      "html": "<div class=\"ds-wrap\"><ol class=\"ds-group\"><li class=\"ds-row\"><span class=\"ds-tile\"><svg viewBox=\"0 0 20 20\" width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\"><circle cx=\"10\" cy=\"6.8\" r=\"3.1\"/><path d=\"M4 16.5c.9-3.1 3.2-4.6 6-4.6s5.1 1.5 6 4.6\"/></svg></span><span class=\"ds-text\"><span class=\"ds-title\">Work</span><span class=\"ds-sub\">Main account</span></span><span class=\"ds-live\">In use</span></li><li class=\"ds-row\"><span class=\"ds-tile ds-key\"><svg viewBox=\"0 0 20 20\" width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\"><circle cx=\"6.6\" cy=\"13.4\" r=\"3.1\"/><path d=\"M8.8 11.2 16 4M13.4 6.6l2 2M11.6 8.4l1.6 1.6\"/></svg></span><span class=\"ds-text\"><span class=\"ds-title\">Top-up key</span><span class=\"ds-sub\">sk-ant-...4f2a</span></span><span class=\"ds-state\"><i class=\"ds-dot\"></i>Ready</span></li></ol><p class=\"ds-foot\">Used first, top to bottom.</p></div>",
      "css": ".ds-wrap{font-family:-apple-system,BlinkMacSystemFont,system-ui,\"Segoe UI\",Roboto,\"Helvetica Neue\",Arial,sans-serif;background:var(--ground,#f2f2f7);padding:16px;max-width:520px}.ds-group{list-style:none;margin:0;padding:0;background:var(--group,#fff);border-radius:12px}.ds-row{position:relative;display:flex;align-items:center;gap:12px;min-height:52px;padding:10px 12px 10px 16px;color:var(--label,#1d1d1f)}.ds-row+.ds-row::before{content:\"\";position:absolute;top:0;right:0;left:58px;height:1px;background:var(--sep,rgba(60,60,67,.17))}.ds-tile{width:30px;height:30px;border-radius:7px;display:grid;place-items:center;flex:none;color:#fff;background:var(--accent-fill,#0071e3)}.ds-key{background:var(--key-tile,#8e8e93)}.ds-text{flex:1;display:grid;gap:1px;min-width:0}.ds-title{font-size:.9375rem;line-height:1.33;font-weight:500;letter-spacing:-.015em}.ds-sub{font-size:.8125rem;line-height:1.33;color:var(--label-2,#6e6e73)}.ds-live{padding:3px 9px;border-radius:999px;background:var(--accent-tint,rgba(0,113,227,.1));color:var(--accent,#0066cc);font-size:.75rem;font-weight:600}.ds-state{display:inline-flex;align-items:center;gap:6px;font-size:.8125rem;color:var(--label-2,#6e6e73)}.ds-dot{width:8px;height:8px;border-radius:50%;background:var(--green,#34c759)}.ds-foot{margin:8px 16px 0;font-size:.8125rem;line-height:1.38;color:var(--label-2,#6e6e73)}"
