      "css": ".ds-btn-primary{font-family:-apple-system,BlinkMacSystemFont,system-ui,\"Segoe UI\",Roboto,\"Helvetica Neue\",Arial,sans-serif;display:inline-flex;align-items:center;height:34px;padding:0 16px;border:0;border-radius:8px;background:var(--accent-fill,#0071e3);color:#fff;font-size:.875rem;font-weight:500;letter-spacing:-.005em;cursor:pointer;transition:transform .12s ease-out,background-color .12s ease}.ds-btn-primary:hover{background:var(--accent-hover,#0077ed)}.ds-btn-primary:active{transform:scale(.97)}.ds-btn-primary:focus-visible{outline:3px solid var(--focus,rgba(0,113,227,.45));outline-offset:2px}"
