      "css": ".ds-toast{font-family:-apple-system,BlinkMacSystemFont,system-ui,\"Segoe UI\",Roboto,\"Helvetica Neue\",Arial,sans-serif;display:inline-flex;align-items:center;gap:8px;padding:10px 16px;border-radius:20px;background:var(--material,rgba(251,251,253,.84));-webkit-backdrop-filter:saturate(180%) blur(24px);backdrop-filter:saturate(180%) blur(24px);box-shadow:0 0 0 .5px rgba(0,0,0,.12),0 12px 32px -6px rgba(0,0,0,.2);color:var(--label,#1d1d1f);font-size:.875rem;font-weight:500;line-height:1.38;letter-spacing:-.012em}"
