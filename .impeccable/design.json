      "css": ".ds-btn{font-family:-apple-system,BlinkMacSystemFont,system-ui,\"Segoe UI\",Roboto,\"Helvetica Neue\",Arial,sans-serif;display:inline-flex;align-items:center;height:30px;padding:0 12px;border:0;border-radius:8px;background:var(--fill,rgba(120,120,128,.12));color:var(--accent,#0066cc);font-size:.8125rem;font-weight:500;letter-spacing:-.005em;cursor:pointer;transition:transform .12s ease-out,background-color .12s ease}.ds-btn:hover{background:var(--fill-2,rgba(120,120,128,.2))}.ds-btn:active{transform:scale(.97)}.ds-btn:focus-visible{outline:3px solid var(--focus,rgba(0,113,227,.45));outline-offset:2px}"
