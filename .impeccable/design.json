      "html": "<div class=\"ds-dock\"><svg class=\"ds-cable\" viewBox=\"0 0 160 60\"><path d=\"M4 8 C60 8 40 44 128 44\" stroke=\"rgba(0,0,0,.07)\" stroke-width=\"6\" fill=\"none\" stroke-linecap=\"round\" transform=\"translate(0 1.6)\"/><path d=\"M4 8 C60 8 40 44 128 44\" stroke=\"var(--cable-edge,rgba(0,0,0,.17))\" stroke-width=\"4.6\" fill=\"none\" stroke-linecap=\"round\"/><path d=\"M4 8 C60 8 40 44 128 44\" stroke=\"var(--cable,#fff)\" stroke-width=\"3.3\" fill=\"none\" stroke-linecap=\"round\"/></svg><button class=\"ds-plug\" aria-label=\"Cable plug\"><span class=\"ds-plug-body\"><span class=\"ds-led\"></span></span></button><span class=\"ds-slot\"></span></div>",
      "css": ".ds-dock{position:relative;width:180px;height:64px;background:var(--ground,#f2f2f7)}.ds-cable{position:absolute;left:0;top:0;width:160px;height:60px;overflow:visible}.ds-plug{position:absolute;left:128px;top:38px;width:22px;height:12px;padding:0;border:0;background:none;cursor:grab}.ds-plug-body{position:absolute;inset:0;border-radius:4px 6px 6px 4px;background:linear-gradient(var(--plug-top,#fff),var(--plug-bottom,#e3e3e8));box-shadow:0 0 0 .5px var(--plug-edge,rgba(0,0,0,.16)),0 1px 2px rgba(0,0,0,.16),0 4px 10px -3px rgba(0,0,0,.18);transform-origin:100% 50%;transition:transform .24s cubic-bezier(.2,.8,.2,1),box-shadow .24s ease}.ds-plug:active .ds-plug-body{transform:scale(1.16);box-shadow:0 0 0 .5px var(--plug-edge,rgba(0,0,0,.16)),0 8px 18px -4px rgba(0,0,0,.3)}.ds-plug:focus-visible{outline:none}.ds-plug:focus-visible .ds-plug-body{box-shadow:0 0 0 .5px rgba(0,0,0,.16),0 0 0 3.5px var(--focus,rgba(0,113,227,.45))}.ds-led{position:absolute;left:6px;top:4px;width:4px;height:4px;border-radius:50%;background:var(--green,#34c759)}.ds-slot{position:absolute;left:150px;top:34px;width:6px;height:20px;border-radius:3px;background:var(--port,#dcdce1);box-shadow:inset 0 1px 2px rgba(0,0,0,.22),0 0 0 1px var(--port-ring,rgba(0,0,0,.07))}"
    }
