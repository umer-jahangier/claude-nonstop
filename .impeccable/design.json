      "html": "<div class=\"ds-menu\" role=\"menu\"><button class=\"ds-mi\" role=\"menuitem\">Use Now</button><button class=\"ds-mi\" role=\"menuitem\">Rename</button><div class=\"ds-msep\"></div><button class=\"ds-mi ds-mi-danger\" role=\"menuitem\">Remove</button></div>",
      "css": ".ds-menu{font-family:-apple-system,BlinkMacSystemFont,system-ui,\"Segoe UI\",Roboto,\"Helvetica Neue\",Arial,sans-serif;min-width:228px;padding:5px;border-radius:12px;background:var(--material,rgba(251,251,253,.84));-webkit-backdrop-filter:saturate(180%) blur(24px);backdrop-filter:saturate(180%) blur(24px);box-shadow:0 0 0 .5px rgba(0,0,0,.12),0 12px 32px -6px rgba(0,0,0,.2);display:inline-block}.ds-mi{display:flex;align-items:center;width:100%;height:32px;padding:0 10px;border:0;border-radius:7px;background:none;color:var(--label,#1d1d1f);font:inherit;font-size:.875rem;letter-spacing:-.012em;text-align:left}.ds-mi:hover,.ds-mi:focus-visible{background:var(--accent-fill,#0071e3);color:#fff;outline:none}.ds-mi-danger{color:var(--red-text,#d70015)}.ds-mi-danger:hover,.ds-mi-danger:focus-visible{background:var(--red,#ff3b30);color:#fff}.ds-msep{height:1px;margin:5px 10px;background:var(--sep,rgba(60,60,67,.17))}"
